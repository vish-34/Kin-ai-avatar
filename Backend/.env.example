# =====================================================================
# KIN AI - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and provide your credentials.
# Do NOT commit .env with real secrets to version control.
# =====================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Atlas
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kin_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/kin_ai

# Security & Authentication
JWT_SECRET=kin_super_secret_jwt_key_change_in_production_32chars_min
JWT_EXPIRES_IN=7d

# Internal Python CloneLLM Service URL
# When running alongside Node.js locally: http://127.0.0.1:5001
# In production on Render (internal service or same container): http://127.0.0.1:5001 or private network URL
PYTHON_SERVICE_URL=http://127.0.0.1:5001

# LLM Providers (used by Python CloneLLM)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Voice Cloning & TTS Provider (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Interactive Avatar Provider (HeyGen)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=default

# Binary Media / Object Storage
# Options: 'local' (writes to uploads directory and serves statically) or 's3'
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
UPLOAD_MAX_SIZE_MB=50
